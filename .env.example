# Notion integration token and the database ID. Never commit your real .env file.
NOTION_API_KEY=secret_xxx
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Required only for `place extract <public-sns-url>`.
GEMINI_API_KEY=AIza_your_key
# Optional model override. The default is gemini-3.5-flash.
# GEMINI_MODEL=gemini-3.5-flash

# Absolute path to a dedicated, already logged-in local Chrome profile.
# Do not use a profile directory shared with a running Chrome session.
NAVER_USER_DATA_DIR=/absolute/path/to/local/naver-map-profile
